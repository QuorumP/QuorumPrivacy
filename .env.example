# Copy to .env.local and fill in. Never commit real values.

# ── Database (Supabase Postgres, server only) ──────────────────────────
DATABASE_URL=
PGHOST=
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=postgres
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Browser (public) ───────────────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Tally group public key (hex); must equal TALLY_PUBKEY or every ballot is rejected
VITE_TALLY_PUBKEY=

# ── Auth ───────────────────────────────────────────────────────────────
# Session signing secret: 32+ random bytes, e.g. `openssl rand -hex 32`
APP_JWT_SECRET=
# Comma-separated wallets allowed to tally a vote before it closes
ADMIN_WALLETS=

# ── Solana ─────────────────────────────────────────────────────────────
SOLANA_RPC=https://api.devnet.solana.com
QRM_MINT=
# JSON array secret key of the program / mint authority (hot key, devnet only)
ANCHOR_AUTHORITY_SECRET=

# ── Tally (threshold ElGamal) ──────────────────────────────────────────
TALLY_PUBKEY=
# JSON {t, n, shares} printed by `bun scripts/crypto/dkg.ts` (stderr, TALLY_SHARES=...)
TALLY_SHARES=

# ZK build intermediates (ptau/r1cs/wasm-js/zkey). Runtime artifacts live in public/zk + src/lib/zk.
build/zk/

# Devnet keypairs (mint authority etc.) — NEVER commit secret keys
.devnet/

# Public-repo publish token (never commit) — used by scripts/publish-public.sh
.public-token

# Anchor / Solana program build output
onchain/target/
onchain/.anchor/

# Env files (secrets) — only the placeholder template is tracked
.env
.env.*
!.env.example
